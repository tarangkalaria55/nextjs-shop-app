model Product {
  id            String          @id @default(cuid())
  name          String
  description   String?
  price         Float
  image         String?
  stock         Int             @default(0)
  category      String?
  cartItems     CartItem[]
  GuestCartItem GuestCartItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  OrderItem     OrderItem[]

  @@map("product")
}
